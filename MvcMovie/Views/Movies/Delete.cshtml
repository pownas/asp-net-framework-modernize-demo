@model MvcMovie.Models.Movie

@{
    ViewBag.Title = "Delete";
}

<h2>Delete Movie</h2>

<div class="alert alert-warning" role="alert">
    <strong>Are you sure?</strong> This action cannot be undone.
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">
            <strong>Release Date:</strong> @Model.ReleaseDate.ToString("yyyy-MM-dd")<br />
            <strong>Genre:</strong> @Model.Genre<br />
            <strong>Price:</strong> $@Model.Price
        </p>
    </div>
</div>

<form asp-controller="Movies" asp-action="DeleteConfirmed" method="post" style="display: inline;">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
