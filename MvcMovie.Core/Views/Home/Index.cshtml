@{
    ViewBag.Title = "Home";
}

<div class="jumbotron">
    <h1>Welcome to Movie App</h1>
    <p class="lead">This is a sample ASP.NET Core application demonstrating a modern migration from .NET Framework.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Get Started</h2>
        <p>Browse and manage movies in our collection.</p>
        <p><a asp-controller="Movies" asp-action="Index" class="btn btn-primary">View Movies →</a></p>
    </div>
    <div class="col-md-4">
        <h2>About</h2>
        <p>Learn more about this application and its features.</p>
        <p><a asp-controller="Home" asp-action="About" class="btn btn-primary">Learn more →</a></p>
    </div>
    <div class="col-md-4">
        <h2>Contact</h2>
        <p>Have questions? Get in touch with us.</p>
        <p><a asp-controller="Home" asp-action="Contact" class="btn btn-primary">Contact us →</a></p>
    </div>
</div>
